{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Any LM Desktop",
  "version": "0.1.0",
  "identifier": "io.github.kidarigun.anylm-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Any LM Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "object-src": "'none'",
        "frame-src": "http://localhost:* https://localhost:* http://127.0.0.1:* https://127.0.0.1:* http://anylm-preview.localhost:*",
        "frame-ancestors": "'none'",
        "child-src": "'self' blob:",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "frame-src": "http://localhost:* https://localhost:* http://127.0.0.1:* https://127.0.0.1:* http://anylm-preview.localhost:*",
        "frame-ancestors": "'none'",
        "child-src": "'self' blob:",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "kidarigun",
    "copyright": "© 2026 김기군",
    "category": "Productivity",
    "shortDescription": "로컬 LLM(LM Studio · Ollama · OpenAI 호환) 작업 앱",
    "longDescription": "LM Studio, Ollama, OpenAI 호환 로컬 모델로 문서를 쓰고, 프로젝트 파일을 다루고, Skill과 MCP로 기능을 넓히는 데스크톱 앱입니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRDEyRUZBMEZBNTdBNkUKUldSdWVxVVAraTdScTZvUkJZZ2hLTnNBSktSbnVwLytwQ0RZcDA4dDFsZmtpV0c1TGVYcEFOM0IK",
      "endpoints": [
        "https://github.com/kidarigun/any-lm-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
