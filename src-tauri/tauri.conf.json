{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop App for LG K-EXAONE",
  "version": "0.4.1",
  "identifier": "io.github.kidarigun.kexaone-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Desktop App for LG K-EXAONE",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "object-src": "'none'",
        "frame-src": "http://exaone-preview.localhost:*",
        "child-src": "'self' blob:",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "frame-src": "http://exaone-preview.localhost:*",
        "child-src": "'self' blob:",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "kidarigun",
    "copyright": "© 2026 김기군. LG AI연구원의 공식 제품이 아닙니다.",
    "category": "Productivity",
    "shortDescription": "LG K-EXAONE용 비공식 데스크톱 앱",
    "longDescription": "LG AI연구원의 K-EXAONE 모델 API로 보고서·문서를 쓰고, 프로젝트 파일을 다루고, Skill과 MCP로 기능을 넓히는 비공식 오픈소스 데스크톱 앱입니다. LG AI연구원이 만들거나 보증하지 않았습니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QTAxNTk2MEU4QUFGM0MKUldROHI0b09saFdnZHFQUDhkRzdqVXgzWktxTE1XSS9XMEdNVzd6R1E4WlZBelFiZTNzNXV1VGcK",
      "endpoints": [
        "https://github.com/kidarigun/k-exaone-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
